from app.core.ai_fusion.skills.coding_skill import CodingSkill
from app.intelligence.providers.gemini import GeminiProvider
from app.providers.registry.provider_registry import ProviderRegistry
class AIRouter:
 def __init__(self):self.g=GeminiProvider();self.registry=ProviderRegistry
 def route(self,n,t): return CodingSkill().execute(t) if n=="coding" else {"s":"OK","p":"gemini","r":self.g.ask(t) or "GEMINI_UNAVAILABLE"} if n=="reasoning" else {"s":"NOT_CONNECTED"} if n in self.registry.capabilities else {"s":"NO"}
